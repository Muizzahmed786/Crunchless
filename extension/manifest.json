{
  "manifest_version": 3,
  "name": "Crunchless Capture",
  "version": "1.0.0",
  "description": "Send selected text to your local Crunchless inbox.",
  "permissions": ["contextMenus", "storage", "tabs"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Crunchless Capture", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }]
}
