{
  "name": "crunchless",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@clerk/react": "^6.18.5",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.13",
    "vite": "^8.3.0"
  }
}
